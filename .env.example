# Salesforce API Configuration
# Copy this file to .env and fill in your credentials

# ============================================================================
# AUTHENTICATION METHOD (default: auto)
# ============================================================================
# Choose authentication method:
#   auto          - Auto-detect SF CLI, fall back to browser cookie (RECOMMENDED)
#   sf_cli        - Use Salesforce CLI (most secure, requires 'sf' installed)
#   browser_cookie - Use browser cookie from environment variables
#   direct_oauth  - Direct OAuth (not yet implemented)

SALESFORCE_AUTH_METHOD=auto

# ============================================================================
# SF CLI AUTHENTICATION (if using SALESFORCE_AUTH_METHOD=sf_cli)
# ============================================================================
# Optional: specify which org to use from SF CLI
# If not set, defaults to first authenticated org
# SALESFORCE_ORG_USERNAME=santiagot@semperis.com

# Optional: path to sf executable (default: 'sf')
# SALESFORCE_CLI_PATH=sf

# ============================================================================
# BROWSER COOKIE AUTHENTICATION (if using SALESFORCE_AUTH_METHOD=browser_cookie)
# ============================================================================
# Your Salesforce instance URL
# Format: https://your-instance.my.salesforce.com/services/data/v59.0
SALESFORCE_BASE_URL=https://your-instance.my.salesforce.com/services/data/v59.0

# Salesforce Session ID (SID) or Access Token
# You can get this from:
# 1. Browser cookies after logging into Salesforce (sid cookie)
# 2. OAuth 2.0 flow access token
SALESFORCE_SID=your_session_id_here

# Alternative name for the access token (either works)
# SALESFORCE_ACCESS_TOKEN=your_access_token_here
